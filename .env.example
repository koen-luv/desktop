# Local development default: http://localhost:1337
# The self-hosted api-worker listens on http://localhost:8787 (see api-worker/).
# Production default: https://api.tryliner.fun (or your deployed Worker URL)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

# Optional: deployed party-worker URL. Leave empty to keep the manual
# invite/answer code exchange for listen parties.
VITE_PARTY_RELAY_URL=

# Optional fallback for the in-app Turnstile widget. The API's challenge
# returns its own public site key and that takes precedence; set this only for
# an older API that does not return one.
VITE_TURNSTILE_SITE_KEY=

LINER_DEV_SIGNING_SECRET=
